      "source": "func mustWrite(t *testing.T, name string, b []byte) {\n\tt.Helper()\n\tif err := os.MkdirAll(filepath.Dir(name), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(name, b, 0o600); err != nil {\n\t\tt.Fatal(err)\n\t}\n}",
