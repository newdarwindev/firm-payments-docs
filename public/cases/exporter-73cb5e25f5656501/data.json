      "path": "docs/internal/dialog/dialog_test.go",
      "label": "Selected test / case body · TestPDFLogFailsClosed",
      "source": "func TestPDFLogFailsClosed(t *testing.T) {\n\tfor _, tc := range []struct {\n\t\tname, text string\n\t\tok         bool\n\t}{\n\t\t{\"complete\", \"Output written on conversation.pdf (20 pages).\", true},\n\t\t{\"empty\", \"\", false},\n\t\t{\"missing glyph\", \"Missing character: glyph\\nOutput written on conversation.pdf\", false},\n\t\t{\"horizontal overflow\", \"Overfull \\\\hbox (2pt)\\nOutput written on conversation.pdf\", false},\n\t\t{\"vertical overflow\", \"Overfull \\\\vbox (2pt)\\nOutput written on conversation.pdf\", false},\n\t} {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tname := filepath.Join(t.TempDir(), \"compiler.log\")\n\t\t\tmustWrite(t, name, []byte(tc.text))\n\t\t\terr := CheckPDFLog(name)\n\t\t\tif (err == nil) != tc.ok {\n\t\t\t\tt.Fatalf(\"expected pass=%v, error=%v\", tc.ok, err)\n\t\t\t}\n\t\t})\n\t}\n\tif err := CheckPDFLog(filepath.Join(t.TempDir(), \"missing.log\")); err == nil {\n\t\tt.Fatal(\"unreadable log accepted\")\n\t}\n}",
